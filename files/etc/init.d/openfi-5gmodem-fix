#!/bin/sh /etc/rc.common
# 5G 配置小修（幂等，不做任何"删接口"的动作）。
#  1. mkiface.sh 生成 device 时去掉 /dev/ 前缀（netifd 只认设备名）；
#  2. 已写坏的 network.*.device 归一化；
#  3. 防火墙 wan 区去重（保留原样，不增不减）。
START=15

fix_mkiface() {
	local f=/usr/share/5gmodem/mkiface.sh
	if [ -f "$f" ] && grep -q 'IDEV="\$DEV"' "$f"; then
		sed -i 's|IDEV="\$DEV"|IDEV="${DEV#/dev/}"|' "$f"
		logger -t openfi-net-fix "mkiface.sh: device 改用设备名"
	fi
	# 让 app 认领我们静态建好的 WAN 接口（wan/wwan），不再另建 modem2。
	# 依据：lib.sh 的 iface_owned_by() 只认 modem_imei/modem_mac，
	# 我们的接口没有这些字段，app 就会绕开并新建接口，造成多个接口抢同一设备。
	local l=/usr/share/5gmodem/lib.sh
	if [ -f "$l" ] && ! grep -q "openfi-net-fix claim" "$l"; then
		sed -i 's/^iface_owned_by() {$/iface_owned_by() {
    case " wan wwan wan6 " in *" $1 "*) return 0 ;; esac # openfi-net-fix claim/' "$l"
		logger -t openfi-net-fix "lib.sh: wan/wwan 视为 app 已认领"
	fi
}

fix_device_paths() {
	local s d secs
	secs=$(uci -q show network 2>/dev/null \
		| sed -n "s/^network\.\([^.]*\)\.device='\/dev\/.*'$/\1/p")
	[ -n "$secs" ] || return 0
	for s in $secs; do
		d=$(uci -q get "network.$s.device"); d=${d#/dev/}
		uci -q set "network.$s.device=$d"
	done
	uci -q commit network
}

fix_firewall() {
	local z cur new n
	z=$(uci -q show firewall 2>/dev/null \
		| sed -n "s/^firewall\.\([^.]*\)\.name='wan'$/\1/p" | head -1)
	[ -n "$z" ] || return 0
	cur=$(uci -q get "firewall.$z.network")
	new=""
	for n in $cur; do
		case " $new " in *" $n "*) continue ;; esac
		new="$new $n"
	done
	new=$(echo $new)
	[ "$new" = "$cur" ] && return 0
	uci -q set "firewall.$z.network=$new"
	uci -q commit firewall
}

boot() {
	fix_mkiface
	fix_device_paths
	fix_firewall
}
