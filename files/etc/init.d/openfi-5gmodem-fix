#!/bin/sh /etc/rc.common
# 5G 配置小修（幂等，不做任何"删接口"的动作）。
#  1. mkiface.sh 生成 device 时去掉 /dev/ 前缀（netifd 只认设备名）；
#  2. 已写坏的 network.*.device 归一化；
#  3. 防火墙 wan 区去重（保留原样，不增不减）；
#  4. 兜底 ifup：app 没认领时按当前设备拉起 wan/wan6/wwan（三者 auto=0）。
START=99

fix_mkiface() {
	local f=/usr/share/5gmodem/mkiface.sh
	if [ -f "$f" ] && grep -q 'IDEV="\$DEV"' "$f"; then
		sed -i 's|IDEV="\$DEV"|IDEV="${DEV#/dev/}"|' "$f"
		logger -t openfi-net-fix "mkiface.sh: device 改用设备名"
	fi
}

fix_device_paths() {
	local s d secs
	secs=$(uci -q show network 2>/dev/null \
		| sed -n "s/^network\.\([^.]*\)\.device='\/dev\/.*'$/\1/p")
	[ -n "$secs" ] || return 0
	for s in $secs; do
		d=$(uci -q get "network.$s.device"); d=${d#/dev/}
		uci -q set "network.$s.device=$d"
	done
	uci -q commit network
}

fix_firewall() {
	local z cur new n
	z=$(uci -q show firewall 2>/dev/null \
		| sed -n "s/^firewall\.\([^.]*\)\.name='wan'$/\1/p" | head -1)
	[ -n "$z" ] || return 0
	cur=$(uci -q get "firewall.$z.network")
	new=""
	for n in $cur; do
		case " $new " in *" $n "*) continue ;; esac
		new="$new $n"
	done
	new=$(echo $new)
	[ "$new" = "$cur" ] && return 0
	uci -q set "firewall.$z.network=$new"
	uci -q commit firewall
}

# 4) LED：WAN 灯跟随当前数据设备（usb0/wwan0），WLAN 灯绑 ra0
fix_leds() {
	local dev l cur
	for d in wwan0 usb0; do
		[ -e "/sys/class/net/$d" ] && { dev="$d"; break; }
	done
	if [ -n "$dev" ]; then
		for l in /sys/class/leds/*/; do
			grep -q "\[netdev\]" "$l/trigger" 2>/dev/null || continue
			cur=$(cat "$l/device_name" 2>/dev/null)
			[ -e "/sys/class/net/$cur" ] && continue
			echo "$dev" > "$l/device_name" 2>/dev/null \
				&& logger -t openfi-net-fix "LED $(basename "$l") -> $dev"
		done
	fi
	# WLAN 灯：绑到 ra0（2.4G AP）
	if [ -e /sys/class/net/ra0 ] && [ -d /sys/class/leds/green:wlan ]; then
		cur=$(cat /sys/class/leds/green:wlan/device_name 2>/dev/null)
		if [ "$cur" != "ra0" ]; then
			echo none > /sys/class/leds/green:wlan/trigger 2>/dev/null
			echo netdev > /sys/class/leds/green:wlan/trigger 2>/dev/null
			echo ra0 > /sys/class/leds/green:wlan/device_name 2>/dev/null
			# netdev 默认 link+tx+rx 都亮，不需要额外写 trigger
			logger -t openfi-net-fix "LED green:wlan -> ra0"
		fi
	fi
}

boot() {
	fix_mkiface
	fix_device_paths
	fix_firewall
	fix_leds
	# 兜底：app 没认领时，按当前设备把对应接口拉起来
	# （wan/wan6/wwan 都设了 auto=0，避免和 app 的接口抢同一个设备）
	if [ -e /sys/class/net/usb0 ]; then
		ifstatus wan 2>/dev/null | grep -q '"up": true' || ifup wan 2>/dev/null
		ifstatus wan6 2>/dev/null | grep -q '"up": true' || ifup wan6 2>/dev/null
	fi
	if [ -e /dev/cdc-wdm0 ]; then
		ifstatus wwan 2>/dev/null | grep -q '"up": true' || ifup wwan 2>/dev/null
	fi
}
