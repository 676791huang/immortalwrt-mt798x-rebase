# 标准写法：sqm 的 interface 必须是网卡名（wwan0 / usb0），不是逻辑接口名。
# 出厂关闭；启用前先测真实上下行，填实测值的 ~90%（单位 kbit/s）。
config queue 'wwan0'
	option enabled '0'
	option interface 'wwan0'
	option download '45000'
	option upload '15000'
	option debug_logging '0'
	option verbosity '5'
	option script 'piece_of_cake.qos'
	option qdisc 'cake'
	option linklayer 'ethernet'
	option overhead '44'
	option ingress '1'
	option iqdisc 'cake'
	option eqdisc_opts 'nat dual-srchost dual-dsthost'
	option iqdisc_opts 'nat dual-dsthost dual-srchost'
